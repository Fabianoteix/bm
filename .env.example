# Copie para .env para rodar a aplicação fora do Docker (apontando para o compose)
APP_DATABASE_URL=mysql+pymysql://app:app@localhost:3306/transactions
APP_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
APP_RISK_SERVICE_URL=http://localhost:8081
APP_LOG_JSON=false
APP_RETRY_MAX_ATTEMPTS=12
APP_RETRY_BASE_DELAY_SECONDS=5
APP_RETRY_MAX_DELAY_SECONDS=600
